# Backend Environment Variables (ShopNow Backend)
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Database Credentials
DB_URL=jdbc:mysql://localhost:3306/shopnow?useSSL=true
DB_USER=root
DB_PASSWORD=your_secure_db_password

# Hibernate DDL and SQL Logging
HIBERNATE_DDL_AUTO=validate
SHOW_SQL=false

# JWT Secret (minimum 64 characters / 512 bits) and Expiration (ms)
JWT_SECRET=your_long_production_jwt_secret_code_user_to_authenticate_by_creating_jwt_token_12345678901234567890
JWT_EXPIRATION=3600000

# Cookie Security (true for HTTPS in production, false for local HTTP)
COOKIE_SECURE=true

# Razorpay Credentials
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://your-domain.com/login/oauth2/code/google

# Rate Limiting Configuration
RATELIMIT_STRICT_IP_CAPACITY=5
RATELIMIT_STRICT_IP_DURATION=1
RATELIMIT_GENERAL_IP_CAPACITY=100
RATELIMIT_GENERAL_IP_DURATION=1
RATELIMIT_USERNAME_CAPACITY=5
RATELIMIT_USERNAME_DURATION=15

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:8080
